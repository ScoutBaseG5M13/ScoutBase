<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="scoutbase.stat.StatsController"
            fitToWidth="true"
            styleClass="center-panel">

    <VBox spacing="18"
          prefWidth="1050"
          styleClass="dashboard-content"
          style="-fx-padding: 30;">

        <Label text="Estadísticas" styleClass="dashboard-title"/>
        <Label text="Resumen visual de equipos, jugadores y rendimiento"
               styleClass="section-subtitle"/>

        <HBox spacing="14">
            <VBox spacing="8" prefWidth="180" styleClass="dashboard-card">
                <Label text="Equipos" styleClass="card-title"/>
                <Label fx:id="totalTeamsLabel" text="0" styleClass="card-value"/>
            </VBox>

            <VBox spacing="8" prefWidth="180" styleClass="dashboard-card">
                <Label text="Jugadores" styleClass="card-title"/>
                <Label fx:id="totalPlayersLabel" text="0" styleClass="card-value"/>
            </VBox>

            <VBox spacing="8" prefWidth="180" styleClass="dashboard-card">
                <Label text="Edad media" styleClass="card-title"/>
                <Label fx:id="averageAgeLabel" text="0" styleClass="card-value"/>
            </VBox>

            <VBox spacing="8" prefWidth="180" styleClass="dashboard-card">
                <Label text="Prioridad media" styleClass="card-title"/>
                <Label fx:id="averagePriorityLabel" text="0" styleClass="card-value"/>
            </VBox>
        </HBox>

        <HBox spacing="18">
            <VBox spacing="10" prefWidth="470" styleClass="info-box">
                <Label text="Distribución por posiciones" styleClass="panel-title"/>
                <PieChart fx:id="positionPieChart" prefHeight="260"/>
            </VBox>

            <VBox spacing="10" prefWidth="470" styleClass="info-box">
                <Label text="Distribución por categorías" styleClass="panel-title"/>
                <PieChart fx:id="categoryPieChart" prefHeight="260"/>
            </VBox>
        </HBox>

        <VBox spacing="10">
            <HBox spacing="10">
                <Label text="Jugadores destacados" styleClass="panel-title"/>
                <Button text="Recargar"
                        onAction="#onReloadClick"
                        styleClass="quick-action-button"/>
            </HBox>

            <TableView fx:id="topPlayersTable" prefHeight="190">
                <columns>
                    <TableColumn fx:id="playerNameColumn" text="Jugador" prefWidth="260"/>
                    <TableColumn fx:id="playerAgeColumn" text="Edad" prefWidth="100"/>
                    <TableColumn fx:id="playerPositionColumn" text="Posición" prefWidth="180"/>
                    <TableColumn fx:id="playerPriorityColumn" text="Prioridad" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>

        <Separator/>

        <VBox spacing="12" styleClass="info-box">
            <Label text="Gestión de estadísticas de jugador" styleClass="panel-title"/>
            <Label text="Selecciona un jugador, carga sus estadísticas actuales o añade una nueva."
                   styleClass="panel-text"/>

            <HBox spacing="10">
                <ComboBox fx:id="playerStatsBox"
                          prefWidth="240"
                          promptText="Seleccionar jugador"/>

                <ComboBox fx:id="statCodeBox"
                          prefWidth="120"
                          promptText="Código"/>

                <Spinner fx:id="statValueSpinner"
                         prefWidth="90"/>

                <Button text="Cargar stats"
                        onAction="#onLoadPlayerStatsClick"
                        styleClass="quick-action-button"/>

                <Button text="Añadir stat"
                        onAction="#onAddStatClick"
                        styleClass="quick-action-button"/>
            </HBox>

            <TableView fx:id="playerStatsTable" prefHeight="190">
                <columns>
                    <TableColumn fx:id="statCodeColumn" text="Código" prefWidth="220"/>
                    <TableColumn fx:id="statValueColumn" text="Valor" prefWidth="140"/>
                </columns>
            </TableView>
        </VBox>

        <Label fx:id="statusLabel" text="" styleClass="panel-text"/>

    </VBox>
</ScrollPane>